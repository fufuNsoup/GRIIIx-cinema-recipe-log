@@ -0,0 +1,26 @@
+//! post LUTs computed from a decoded image (no Session): grlog_luts_img IMAGE OUTDIR [--hc]
+use grlook::grlog::{self, Encoding, To};
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let hc = a.iter().any(|x| x == "--hc");
+    let img = std::fs::read(&a[1]).unwrap();
+    let out = std::path::PathBuf::from(&a[2]); std::fs::create_dir_all(&out).unwrap();
+    let cam = grlog::camera(&img, hc).unwrap();
+    let enc = enc_from_env(&cam);
+    let c = grlog::curve(&cam, enc);
+    std::fs::write(out.join("curve.u16"), c.iter().flat_map(|v| v.to_le_bytes()).collect::<Vec<u8>>()).unwrap();
+    let tag = if hc { "-HC" } else { "" };
+    for (to, name) in [(To::Standard, "Standard"), (To::Rec709, "Rec709")] {
+        for size in [33usize, 65] {
+            let cube = grlog::post_lut(&cam, enc, &to, size, &format!("GR-Log{tag} to {name}")).unwrap();
+            std::fs::write(out.join(format!("GR-Log{tag}_to_{name}_{size}.cube")), cube).unwrap();
+        }
+    }
+}
+
+fn enc_from_env(cam: &grlook::lutfit::Camera) -> Encoding {
+    match std::env::var("GRLOG_LO") {
+        Ok(lo) => { let lo: f64 = lo.parse().unwrap(); Encoding::new(lo, Encoding::top_ev(cam) - lo).unwrap() }
+        Err(_) => Encoding::DEFAULT,
+    }
+}
