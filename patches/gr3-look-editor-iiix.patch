+++ b/core/examples/grlog_dump.rs
@@ -0,0 +1,20 @@
+//! dump the GR-Log decoder (code -> look-linear) and Standard's matrix: grlog_dump IMAGE OUT.json [--hc]
+use grlook::grlog::{self, Encoding};
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let hc = a.iter().any(|x| x == "--hc");
+    let img = std::fs::read(&a[1]).unwrap();
+    let cam = grlog::camera(&img, hc).unwrap();
+    let enc = enc_from_env(&cam); let dec = grlog::decoder(&cam, enc);
+    let n = 4096;
+    let t: Vec<f64> = (0..n).map(|k| dec(k as f64 / (n - 1) as f64)).collect();
+    let j = serde_json::json!({ "decode": t, "standard": cam.standard, "top_ev": Encoding::top_ev(&cam), "lo": enc.lo, "span": enc.span });
+    std::fs::write(&a[2], j.to_string()).unwrap();
+}
+
+fn enc_from_env(cam: &grlook::lutfit::Camera) -> Encoding {
+    match std::env::var("GRLOG_LO") {
+        Ok(lo) => { let lo: f64 = lo.parse().unwrap(); Encoding::new(lo, Encoding::top_ev(cam) - lo).unwrap() }
+        Err(_) => Encoding::DEFAULT,
+    }
+}
diff --git a/core/examples/grlog_iiix.rs b/core/examples/grlog_iiix.rs
