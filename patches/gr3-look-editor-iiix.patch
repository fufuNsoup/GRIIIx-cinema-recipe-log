@@ -0,0 +1,34 @@
+//! GR-Log on a chosen look for the GR IIIx 1.60: writes the decoded image with GR-Log
+//! and the post LUTs. Usage: grlog_iiix UPDATE OUTDIR TARGET [--hc]
+use std::path::PathBuf;
+use grlook::grfw::Container;
+use grlook::grlog::{self, Encoding, To};
+use grlook::session::Session;
+use serde_json::json;
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let hc = a.iter().any(|x| x == "--hc");
+    let s = Session::open(std::fs::read(&a[1]).unwrap(), "fwdc243b.bin").unwrap();
+    let out = PathBuf::from(&a[2]); let target = a[3].as_str();
+    std::fs::create_dir_all(&out).unwrap();
+    let cam = grlog::camera(s.image(), hc).unwrap();
+    let enc = enc_from_env(&cam);
+    let spec = grlog::spec(&cam, target, enc).unwrap();
+    let (_r, packed, _p) = s.export(&json!({ "targets": { target: spec } })).unwrap();
+    let img = Container::parse(packed).unwrap().decode().unwrap();
+    std::fs::write(out.join("image-grlog.bin"), &img).unwrap();
+    let tag = if hc { "-HC" } else { "" };
+    for (to, name) in [(To::Standard, "Standard"), (To::Rec709, "Rec709")] {
+        let cube = grlog::post_lut(&cam, enc, &to, 33, &format!("GR-Log{tag} to {name}")).unwrap();
+        std::fs::write(out.join(format!("GR-Log{tag}_to_{name}.cube")), cube).unwrap();
+    }
+    let first = (16.0 / (0.18 * cam.scale)).log2();
+    println!("hc {hc} log range EV {first:.2} .. {:.2} grey code {}", Encoding::top_ev(&cam), (255.0 * enc.encode(0.18)).round());
+}
+
+fn enc_from_env(cam: &grlook::lutfit::Camera) -> Encoding {
+    match std::env::var("GRLOG_LO") {
+        Ok(lo) => { let lo: f64 = lo.parse().unwrap(); Encoding::new(lo, Encoding::top_ev(cam) - lo).unwrap() }
+        Err(_) => Encoding::DEFAULT,
+    }
+}
