+//! Decode a GR IIIx update file to its image, optionally with judgem00's tested video bundle
+//! (manual mlive7 dials osd bitrate). Usage: iiix_image FWDC243B.BIN OUT_IMAGE [--video]
+use grlook::grfw::Container;
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let mut img = Container::parse(std::fs::read(&a[1]).unwrap()).unwrap().decode().unwrap();
+    if a.iter().any(|x| x == "--video") {
+        let names = grlook::video::names_from(Some(&serde_json::Value::Bool(true))).unwrap();
+        for line in grlook::video::apply(&mut img, &names).unwrap() { println!("{line}"); }
+    }
+    std::fs::write(&a[2], &img).unwrap();
+}
